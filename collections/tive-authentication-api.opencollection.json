{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tive Public Alerts Authentication API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain a bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tive.com/public/v3/authenticate",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Exchange client credentials for a short-lived bearer token. Tokens currently have a lifetime of one hour (3600 seconds)."
        }
      ]
    }
  ],
  "bundled": true
}