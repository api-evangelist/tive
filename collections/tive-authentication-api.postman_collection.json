          "name": "Obtain a bearer token",
          "request": {
            "name": "Obtain a bearer token",
            "description": {
              "content": "Exchange client credentials for a short-lived bearer token. Tokens currently have a lifetime of one hour (3600 seconds).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authenticate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
