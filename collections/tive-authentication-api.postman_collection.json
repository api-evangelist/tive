                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "client_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Your application's public identifier."
                },
                {
                  "key": "client_secret",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Your confidential application secret."
                },
                {
                  "key": "grant_type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of client_credentials)"
                }
              ]
            }
          },
