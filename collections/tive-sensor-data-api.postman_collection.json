          "name": "Get shipment tracker data",
          "request": {
            "name": "Get shipment tracker data",
            "description": {
              "content": "Returns the shipment's tracker sensor data - location, temperature, humidity, pressure, light, motion, and battery. Optionally narrow the result with a UTC start and end date range; if omitted, the full shipment duration is returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shipments",
                ":shipmentId",
                "trackerData"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "UTC start of the sensor data range."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "UTC end of the sensor data range."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "shipmentId",
                  "description": "(Required) The public shipment identifier."
                }
              ]
            },
